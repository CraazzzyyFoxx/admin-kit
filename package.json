{
  "name": "@craazzzyyfoxx/admin-kit",
  "version": "0.2.0",
  "description": "Admin list table, pagination and form kit for Next.js apps on shadcn/ui and Tailwind 4",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraazzzyyFoxx/admin-kit.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./data-table": {
      "types": "./dist/data-table/index.d.ts",
      "default": "./dist/data-table/index.js"
    },
    "./data-table/*": {
      "types": "./dist/data-table/*.d.ts",
      "default": "./dist/data-table/*.js"
    },
    "./kit/*": {
      "types": "./dist/kit/*.d.ts",
      "default": "./dist/kit/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
      "default": "./dist/messages/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.0",
    "lucide-react": "^1.28.0",
    "next": "^16.0.0",
    "next-intl": "^4.13.0",
    "radix-ui": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^3.7.0",
    "use-debounce": "^10.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
